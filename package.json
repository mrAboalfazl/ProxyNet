{
  "name": "@platform/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "node_modules/.bin/prisma migrate dev --schema=apps/control-plane/prisma/schema.prisma",
    "db:migrate:prod": "node_modules/.bin/prisma migrate deploy --schema=apps/control-plane/prisma/schema.prisma",
    "db:generate": "node_modules/.bin/prisma generate --schema=apps/control-plane/prisma/schema.prisma",
    "db:seed": "node -r @swc-node/register apps/control-plane/prisma/seed.ts",
    "db:studio": "node_modules/.bin/prisma studio --schema=apps/control-plane/prisma/schema.prisma",
    "cp:dev": "npm exec nx serve control-plane",
    "web:dev": "npm exec nx serve web"
  },
  "private": true,
  "devDependencies": {
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "23.1.2",
    "@nx/js": "23.1.2",
    "@nx/nest": "^23.1.2",
    "@nx/next": "^23.1.2",
    "@nx/node": "23.1.2",
    "@nx/playwright": "23.1.2",
    "@nx/web": "23.1.2",
    "@nx/webpack": "23.1.2",
    "@playwright/test": "^1.37.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "nx": "23.1.2",
    "prettier": "~3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
